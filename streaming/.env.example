# REQUIRED
PUBLIC_BASE_URL=https://your-domain.com
OPENAI_API_KEY=sk-proj-...
ELEVENLABS_API_KEY=...

# Optional but recommended
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
RESEND_API_KEY=...
RESEND_FROM_EMAIL=noreply@yourapp.com
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
STRIPE_SECRET_KEY=...
STRIPE_WEBHOOK_SECRET=...
WEB_BASE_URL=http://localhost:3000
ADMIN_API_KEY=change-me-in-production
SKIP_TWILIO_SIGNATURE_VALIDATION=false
PORT=5050
DATA_DIR=./data

# ── Persistence (READ THIS FIRST ON A NEW DEPLOY) ─────────────────────────────
# DATA_DIR holds the SQLite lead database, the per-firm config JSON files and the
# TTS audio cache. It defaults to ./data INSIDE the build directory, which on
# Railway is recreated on every deploy — leads, firm configs and cached audio are
# destroyed each time you push, and callers to a client's number are then greeted
# with the default firm's name and their leads go to the default address.
# Attach a persistent volume and point DATA_DIR at its mount path.
DATA_DIR=/data

# ── Twilio ───────────────────────────────────────────────────────────────────
# TWILIO_AUTH_TOKEN is REQUIRED in production. Without it (and without
# SKIP_TWILIO_SIGNATURE_VALIDATION=true) every inbound call is rejected before
# Ava speaks and the caller hears Twilio's generic error.
TWILIO_FROM_NUMBER=
DEMO_PHONE_NUMBER=

# Dashboard origin allowed to call this API from the browser, in addition to
# WEB_BASE_URL. Comma-separated. Without a match the dashboard's client-side
# fetches are blocked by CORS and its lists render empty.
CORS_ALLOWED_ORIGINS=

# Where lead notification links point. Left at localhost, every "View Lead in
# Dashboard" link in the notification emails is dead.
WEB_BASE_URL=http://localhost:3000

# ── Notifications ────────────────────────────────────────────────────────────
# Fallback notification address for the default firm config.
NOTIFICATION_EMAIL=

# ── Billing ──────────────────────────────────────────────────────────────────
STRIPE_PRICE_ID=

# ── Voice tuning (ElevenLabs) ────────────────────────────────────────────────
# Leave these UNSET to use the defaults. Setting one to an empty string is not
# the same as leaving it out; blank values are ignored rather than parsed as 0.
ELEVEN_STABILITY=0.55
ELEVEN_SIMILARITY=0.75
ELEVEN_STYLE=0.10
ELEVEN_SPEAKER_BOOST=true
ELEVEN_SPEED=1.00

# ── Timeouts and budgets (milliseconds) ──────────────────────────────────────
OPENAI_TIMEOUT_MS=8000
RESEND_TIMEOUT_MS=5000
TWILIO_TIMEOUT_MS=5000
TTS_TIMEOUT_MS=2500
TTS_BUDGET_MS=15000
MAX_TTS_CHARS=260
DASHBOARD_DB_TIMEOUT_MS=8000
STT_LOW_CONFIDENCE_THRESHOLD=0.55

# ── Rate limiting (counts NEW CALLS, never turns) ────────────────────────────
RATE_LIMIT_IP_CALLS_PER_MIN=30
RATE_LIMIT_FIRM_CALLS_PER_DAY=200
